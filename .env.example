# Database
DATABASE_URL=postgresql://graph_agent:graph_agent_pass@127.0.0.1:5432/graph_agent_db

# LLM adapter: "ollama" | "openai_compat" | "mock"
GRAPH_AGENT_LLM_ADAPTER=ollama

# Local Ollama Configuration
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gptoss:20b

# Logging
LOG_LEVEL=INFO
