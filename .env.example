# Database
DATABASE_URL=postgresql://graph_agent:graph_agent_pass@127.0.0.1:5432/graph_agent_db

# LLM adapter: "mock" | "openai_compat"
LLM_ADAPTER=mock

# OpenAI-compatible endpoint (only needed when LLM_ADAPTER=openai_compat)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Repair
MAX_REPAIR_RETRIES=3

# Logging
LOG_LEVEL=INFO
